# Accessibility Auditor environment template
# Copy to .env on the server and fill only real secrets there.

# Telegram bot / service
TELEGRAM_BOT_TOKEN=
AUDIT_SERVICE_URL=https://hexdrive.tech

# Existing fixed-price x402 single-page audit settings
X402_SERVER_ADDRESS=
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator

# Fortytwo x402Escrow multi-page audits
# Public website and Telegram bot remain single-page/free. Multi-page is paid-only.
X402ESCROW_ENABLED=true
X402ESCROW_LIVE=false
X402ESCROW_DRY_RUN=true
X402ESCROW_ALLOW_DRY_RUN_REQUESTS=false

# Chosen network for Fortytwo integration: Base mainnet.
# Fortytwo does not grant external facilitator role on its official escrow.
# Deploy your own Fortytwo x402Escrow proxy and put the PROXY address here.
X402ESCROW_NETWORK=base
X402ESCROW_CHAIN_ID=8453
X402ESCROW_RPC_URL=https://base-rpc.publicnode.com
X402ESCROW_CONTRACT_ADDRESS=

# Secret: set only on production, never commit a real value.
X402ESCROW_FACILITATOR_PRIVATE_KEY=
